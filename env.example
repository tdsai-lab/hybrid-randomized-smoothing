# Environment template for hybrid-rs.
# Copy this to env.local and edit the paths for your machine, then:
#   source env.local
# (env.local is gitignored.)
#
# All variables are optional; the code falls back to ./data and the
# huggingface defaults when they are not set.

# --- Diffusion checkpoint (only needed for --use_diffusion runs) ---
# Either set DIFFUSION_CKPT directly to the .pt file:
# export DIFFUSION_CKPT=/path/to/256x256_diffusion_uncond.pt
# ...or set HYBRID_RS_DATA_ROOT and place the file at
#    $HYBRID_RS_DATA_ROOT/256x256_diffusion_uncond.pt

# --- Dataset root (auto-discovers MM-SafetyBench, hateful_memes, unsafebench) ---
# export HYBRID_RS_DATA_ROOT=/path/to/data_root

# --- Per-dataset overrides (only set the ones you actually use) ---
# export HATEFUL_MEMES_DATASET_DIR=/path/to/hateful_memes_hf
# export UNSAFEBENCH_DATASET_DIR=/path/to/unsafebench_interaction_unsafe_hf
# export MM_SAFETYBENCH_ROOT=/path/to/MM-SafetyBench

# --- HuggingFace cache (Flickr30k loader looks here first) ---
# export HF_HOME=/path/to/huggingface
# export FLICKR30K_CACHE_DIR=/path/to/huggingface
